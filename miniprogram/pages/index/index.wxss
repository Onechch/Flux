/* pages/index/index.wxss —— 瓶颈仪表盘（深蓝 + 警示橙） */

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 140rpx;
  box-sizing: border-box;
  background: #0F1B33;
}

/* ---- 顶部：标题 + 进行中计数 ---- */
.top-bar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.top-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #EAF0FA;
}
.top-count {
  font-size: 24rpx;
  color: #8A93A6;
}

/* ---- 多任务警告横幅 ---- */
.warning-banner {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  margin-bottom: 28rpx;
  border-radius: 16rpx;
  background: rgba(245, 135, 42, 0.12);
  border: 1rpx solid rgba(245, 135, 42, 0.35);
  animation: fadeIn 0.3s ease;
}
.warning-icon {
  font-size: 30rpx;
  line-height: 1.5;
  margin-right: 14rpx;
}
.warning-text {
  flex: 1;
  font-size: 24rpx;
  color: #FFB066;
  line-height: 1.6;
}

/* ---- 空状态 ---- */
.empty-state {
  padding: 120rpx 0;
  text-align: center;
}
.empty-icon {
  font-size: 88rpx;
}
.empty-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #EAF0FA;
}
.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8A93A6;
}

/* ---- 任务卡片 ---- */
.task-list {
  margin-top: 8rpx;
}
.task-card {
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 18rpx;
  background: #16213E;
  border: 1rpx solid #24365A;
  animation: fadeIn 0.3s ease;
}

/* 瓶颈任务：橙色边框 + 微橙背景 + 大号加粗 */
.task-card.bottleneck {
  border: 3rpx solid #FF7E00;
  background: rgba(255, 126, 0, 0.08);
  box-shadow: 0 8rpx 32rpx rgba(255, 126, 0, 0.18);
}
.task-card.bottleneck .task-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  word-break: break-all;
}

/* 锁定任务：更暗背景 + 降不透明度 */
.task-card.locked {
  background: #10192E;
  opacity: 0.55;
}

/* 标签行 */
.card-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}
.tag {
  margin-right: 12rpx;
  margin-bottom: 4rpx;
}
.tag-bottleneck {
  color: #FF9A3D;
  background: rgba(255, 126, 0, 0.16);
  font-weight: 600;
}
.tag-locked {
  color: #8A93A6;
  background: rgba(138, 147, 166, 0.14);
}
.tag-pending {
  color: #7C8699;
  background: rgba(124, 134, 153, 0.12);
}
.tag-sub {
  color: #6FA8DC;
  background: rgba(111, 168, 220, 0.12);
}

/* 任务名称（非瓶颈） */
.task-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #D5DCEA;
  word-break: break-all;
}

/* 耗时信息 */
.task-meta {
  display: flex;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5E6A85;
}
.task-meta text {
  margin-right: 28rpx;
}
.task-card.bottleneck .task-meta {
  color: #C88A4A;
  font-size: 26rpx;
}

/* ---- 进度条（瓶颈任务，平滑过渡） ---- */
.progress-track {
  margin-top: 22rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #0D1730;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  width: 0;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #B85C1F, #F5872A);
  transition: width 0.4s ease;
}

/* ---- 大目标行（点击展开/收起子任务） ---- */
.goal-row {
  display: flex;
  align-items: flex-start;
}
.expand-arrow {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  line-height: 1.6;
  color: #5E6A85;
  transition: transform 0.25s ease;
}
.expand-arrow.expanded {
  transform: rotate(90deg);
  color: #FF9A3D;
}
.goal-main {
  flex: 1;
  min-width: 0;
}

/* ---- 子任务列表（展开时显示） ---- */
.subtask-list {
  margin-top: 20rpx;
  padding: 8rpx 0 8rpx 56rpx;
  border-top: 1rpx solid rgba(36, 54, 90, 0.6);
}
.subtask-row {
  display: flex;
  align-items: center;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
}
.subtask-row:active {
  background: rgba(13, 23, 48, 0.7);
}
.sub-check {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #5E6A85;
}
.subtask-row.done .sub-check {
  color: #3FA46A;
}
.sub-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #B8C2D4;
  word-break: break-all;
}
.subtask-row.done .sub-title {
  color: #4A5570;
  text-decoration: line-through;
}
.sub-hours {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #4A5570;
}
.sub-lock {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
}

/* ---- 目标内"卡点"子任务（橙色高亮） ---- */
.subtask-row.sub-bottleneck {
  background: rgba(255, 126, 0, 0.10);
  border-left: 3rpx solid #FF7E00;
}
.subtask-row.sub-bottleneck .sub-title {
  color: #FF9A3D;
  font-weight: 600;
}
.subtask-row.sub-bottleneck .sub-check {
  color: #FF9A3D;
}
.sub-tag-clog {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #FF9A3D;
  background: rgba(255, 126, 0, 0.16);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

/* ---- 完成按钮 ---- */
.card-actions {
  margin-top: 24rpx;
}
.btn-complete {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  margin: 0;
  padding: 0;
  background: linear-gradient(135deg, #F5872A, #FF7A00);
  color: #FFFFFF;
}

/* ---- 添加任务 ---- */
.add-section {
  margin-top: 40rpx;
}
.add-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 18rpx;
  border: 2rpx dashed #2A3C61;
  color: #8A93A6;
  font-size: 28rpx;
}
.add-toggle-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}
.add-form {
  padding: 28rpx 24rpx;
  border-radius: 18rpx;
  background: #16213E;
  border: 1rpx solid #24365A;
}
.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #0D1730;
  color: #EAF0FA;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.input-ph {
  color: #4A5570;
}
.form-actions {
  display: flex;
}
.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  margin: 0;
  padding: 0;
}
.btn-primary {
  background: linear-gradient(135deg, #F5872A, #FF7A00);
  color: #FFFFFF;
}
.btn-ghost {
  background: transparent;
  border: 2rpx solid #2A3C61;
  color: #8A93A6;
}

/* ---- 数据源角标 ---- */
.mode-badge {
  position: fixed;
  bottom: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #4A5570;
  background: rgba(13, 23, 48, 0.92);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

/* ---- 瓶颈"破裂"动画（完成任务时） ---- */
@keyframes burst {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.3); opacity: 0.5; }
  100% { transform: scale(0); opacity: 0; }
}
.burst-effect {
  animation: burst 0.6s ease-out forwards;
}

/* ---- 通用关键帧 ---- */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
