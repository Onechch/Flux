/* pages/fluctuation/index.wxss —— 波动预警页占位样式 */
.placeholder {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
}
.ph-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.ph-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #EAF0FA;
}
.ph-desc {
  margin-top: 16rpx;
  color: #8A93A6;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.6;
}
.ph-tag {
  margin-top: 40rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(245, 135, 42, 0.12);
  color: #F5872A;
  font-size: 24rpx;
}
